{
  "workspaces": {
    ".": {
      "entry": ["vitest.config.ts", "tests/**/*.test.ts", "tests/fixtures/*.ts", "tests/fixtures/*.mjs"],
      "project": ["vitest.config.ts", "tests/**/*.ts", "tests/**/*.mjs"]
    },
    "packages/*": {
      "entry": ["src/index.ts!", "src/**/*.test.ts"],
      "project": ["src/**/*.ts"]
    },
    "packages/runner": {
      "entry": ["src/index.ts!", "src/cli.ts!", "src/**/*.test.ts", "tsup.config.ts", "rollup.dts.config.mjs"],
      "project": ["src/**/*.ts", "*.ts", "*.mjs"],
      "ignoreDependencies": ["ffmpeg-static", "ffprobe-static", "zod"]
    },
    "apps/desktop": {
      "entry": ["src/main/index.ts!", "src/main/screenshots/overview-worker.ts!", "src/preload/*.ts!", "src/renderer/app/index.tsx!", "src/**/*.test.ts", "vite.*.config.ts"],
      "project": ["src/**/*.ts", "src/**/*.tsx", "vite.*.config.ts"]
    }
  }
}
