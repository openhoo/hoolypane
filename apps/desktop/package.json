{
  "name": "@hoolypane/desktop",
  "version": "0.1.0-beta.5",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Direct Chromium multi-viewport desktop browser",
  "author": {
    "name": "Hoolypane contributors",
    "email": "hoolypane@users.noreply.github.com"
  },
  "homepage": "https://github.com/openhoo/hoolypane",
  "repository": {
    "type": "git",
    "url": "https://github.com/openhoo/hoolypane.git"
  },
  "main": "dist/main/index.js",
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "build": "pnpm icons && vite build --config vite.main.config.ts && vite build --config vite.preload.config.ts --mode chrome && vite build --config vite.preload.config.ts --mode pane && vite build --config vite.renderer.config.ts",
    "start": "electron .",
    "package:linux": "pnpm build && node scripts/package-desktop.mjs linux",
    "package:windows": "pnpm build && node scripts/package-desktop.mjs windows",
    "package:mac": "pnpm build && node scripts/package-desktop.mjs mac"
  },
  "dependencies": {
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@hoolypane/contracts": "workspace:*",
    "@hoolypane/flow": "workspace:*",
    "@preact/preset-vite": "2.10.2",
    "@tailwindcss/vite": "4.3.3",
    "electron": "43.4.1",
    "electron-builder": "26.15.3",
    "preact": "10.27.3",
    "vite": "7.3.5"
  }
}
